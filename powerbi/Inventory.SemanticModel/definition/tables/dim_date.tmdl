table dim_date
	lineageTag: 5d9facfa-c703-5ba0-9c76-c07cf035cc49
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		lineageTag: 2451f176-43f4-54e1-a04e-12820d9498a3
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		lineageTag: 89f52b1c-78fb-5501-95b0-54f94c1b2da0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		lineageTag: 30317ecb-1ba9-569b-b3e3-9e5566512db8
		summarizeBy: none
		sourceColumn: [Month No]

	column Month
		dataType: string
		lineageTag: 187f08e0-b952-56a4-9db0-c2a689b46fb3
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Sort'

	column 'Month Sort'
		dataType: int64
		lineageTag: 6badd69d-8986-52e2-b351-551d412a77c3
		summarizeBy: none
		sourceColumn: [Month Sort]

	partition dim_date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month No", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM yyyy"),
				    "Month Sort", YEAR([Date]) * 100 + MONTH([Date])
				)
