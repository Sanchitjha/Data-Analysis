table _Measures
	lineageTag: fe7877ce-ca12-5a9c-ba0a-d2bfb90604e7

	measure 'Total Sales' = SUM(fact_sales[revenue])
		lineageTag: ff365443-cf6a-51d8-bf2c-0102882c5325
		formatString: $#,0
		displayFolder: Sales

	measure 'Units Sold' = SUM(fact_sales[quantity])
		lineageTag: acc93a69-5bc2-5c7f-9cd4-959b4e4323bd
		formatString: #,0
		displayFolder: Sales

	measure 'Gross Profit' = SUMX(fact_sales, fact_sales[revenue] - fact_sales[quantity] * RELATED(dim_products[unit_cost]))
		lineageTag: c430143d-51b3-5cd1-abda-872145674f00
		formatString: $#,0
		displayFolder: Sales

	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Total Sales])
		lineageTag: 498ea6b6-358b-563b-9758-cabd602e16d7
		formatString: 0.0%
		displayFolder: Sales

	measure 'Sales LY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR(dim_date[Date]))
		lineageTag: c0d617b5-53e4-5a6e-9221-1c0651fb23a7
		formatString: $#,0
		displayFolder: Sales

	measure 'Sales YoY %' = DIVIDE([Total Sales] - [Sales LY], [Sales LY])
		lineageTag: 701dfcfb-6164-501a-b63a-ac4c79230860
		formatString: 0.0%
		displayFolder: Sales

	measure 'Revenue Rank' = RANKX(ALL(dim_products[product_name]), [Total Sales], , DESC)
		lineageTag: 1f9e1591-508d-5014-b314-703fba310793
		formatString: 0
		displayFolder: Sales

	measure 'Total Stock' = SUM(fact_inventory[current_stock])
		lineageTag: 75cfdf22-67bb-5201-ace1-9f7fd4fd4d9a
		formatString: #,0
		displayFolder: Inventory

	measure 'Low-Stock Items' = COUNTROWS(FILTER(fact_inventory, fact_inventory[current_stock] <= fact_inventory[reorder_level]))
		lineageTag: 1491b192-7c25-5547-a0ba-a094e5985955
		formatString: #,0
		displayFolder: Inventory

	measure 'Opening Stock' = VAR d = CALCULATE(MIN(fact_restocks[restock_date]), ALL(fact_restocks)) RETURN CALCULATE(SUM(fact_restocks[quantity]), fact_restocks[restock_date] = d)
		lineageTag: b110bd3f-d5a3-5786-9f63-87fec55e2c4c
		formatString: #,0
		displayFolder: Inventory

	measure 'Average Stock' = DIVIDE([Opening Stock] + [Total Stock], 2)
		lineageTag: 6cfa8ff6-e23c-5d31-9030-61893874b16a
		formatString: #,0.0
		displayFolder: Inventory

	measure 'Stock Turnover' = DIVIDE([Units Sold], [Average Stock])
		lineageTag: 3525fe6e-ab3d-5f7b-89e8-d5408c7da1a2
		formatString: 0.00
		displayFolder: Inventory

	measure 'Days in Period' = DATEDIFF(CALCULATE(MIN(fact_sales[order_date]), ALL(fact_sales)), CALCULATE(MAX(fact_sales[order_date]), ALL(fact_sales)), DAY) + 1
		lineageTag: be1c01d0-34fd-5cb3-9ff7-bca1196ae1c4
		formatString: 0
		displayFolder: Inventory

	measure 'Days of Inventory' = DIVIDE([Days in Period], [Stock Turnover])
		lineageTag: 59a9fdb9-42cc-512f-bac1-789603cfa4c7
		formatString: 0
		displayFolder: Inventory

	measure 'Reorder Status' = IF(SUM(fact_inventory[current_stock]) <= SUM(fact_inventory[reorder_level]), "REORDER", "OK")
		lineageTag: e3fdb234-8f5f-5321-b105-3c094dbca0a7
		displayFolder: Inventory

	measure Shortfall = MAX(0, SUM(fact_inventory[reorder_level]) - SUM(fact_inventory[current_stock]))
		lineageTag: a8e9b3cb-76ce-5924-ae6a-d78f855853c4
		formatString: #,0
		displayFolder: Inventory

	measure 'Movement Class' = VAR t = [Stock Turnover] VAR p75 = PERCENTILEX.INC(ALL(dim_products), [Stock Turnover], 0.75) VAR p25 = PERCENTILEX.INC(ALL(dim_products), [Stock Turnover], 0.25) RETURN IF(t >= p75, "Fast", IF(t <= p25, "Slow", "Medium"))
		lineageTag: e3abee1b-a2cb-5cce-a261-f1df0f1e3402
		displayFolder: Inventory

	partition _Measures = calculated
		mode: import
		source = ROW("x", 1)
