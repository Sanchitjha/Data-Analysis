# Copy to .env (never commit .env)
# Local Docker/Postgres:
DATABASE_URL=postgresql+psycopg2://inventory:inventory@localhost:5432/inventory
# Hosted PostgreSQL (Neon / Supabase / RDS) - keep sslmode=require:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
PRESET=demo                # demo (60 SKUs x 3 warehouses) | large (300 SKUs x 6 warehouses, ~1.5M rows)
SIM_SEED=42
# Replenishment model
SERVICE_LEVEL_Z=1.65       # 1.65 ~ 95% service level, 2.33 ~ 99%
ORDERING_COST=50           # $ per purchase order
HOLDING_RATE=0.20          # fraction of unit cost per year
# REST API (optional): when set, requests must send X-API-Key
API_KEY=
# Reorder alerts (optional; without these `invsales alerts --send` only logs a warning)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
# Kaggle (only for `invsales kaggle`)
KAGGLE_USERNAME=
KAGGLE_KEY=
